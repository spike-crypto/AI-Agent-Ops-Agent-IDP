# Copy to .env and fill in. .env is git-ignored: never commit real values.
# scripts/push-github-settings.sh copies the GITHUB section into the repo's settings.

# ---------- App (local runs; set the same keys in Render > Environment) ----------
APP_ENV=development
COMPANY_NAME=Hiring Desk
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=hr@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=HR Admin

# AI: there is no offline fake model. Leave the key empty and AI actions are disabled,
# saying so plainly, until a real key is set.
OPENROUTER_API_KEY=
# First is the main model, the rest are fallbacks. Check current free models on openrouter.ai.
OPENROUTER_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1200
LLM_CONCURRENCY=3

# Background agent jobs run in this process. Set false only if a separate worker runs them.
RUN_WORKER=true

AGENTOPS_API_KEY=

# SQLite for local development; Render injects the Postgres URL in production.
DATABASE_URL=sqlite:///./data/hr.db

# Token lifetimes and protection (defaults shown).
# JWT_EXPIRY_MINUTES=15
# REFRESH_TOKEN_DAYS=14
# MFA_TOKEN_MINUTES=5
# PASSWORD_RESET_MINUTES=30
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MINUTES=15
# LOCKOUT_MINUTES=15
# PUBLIC_APPLY_PER_HOUR=5

# Optional single sign-on. Leave OIDC_ISSUER empty to hide the SSO button.
# OIDC_ISSUER=https://your-tenant.auth0.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://your-app.example.com/auth/oidc/callback
# OIDC_AUTO_PROVISION=false
# OIDC_DEFAULT_ROLE=interviewer

# Logging: JSON lines in production, human text locally.
# LOG_LEVEL=INFO
# LOG_JSON=false

# ---------- GITHUB (used by the deploy workflow) ----------
# Render > your service > Settings > Deploy Hook. Saved as a GitHub *secret*.
RENDER_DEPLOY_HOOK_URL=
# Your service URL, with https:// and no trailing slash. Saved as a GitHub *variable*.
APP_URL=
