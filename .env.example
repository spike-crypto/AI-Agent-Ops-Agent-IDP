# Copy to .env and fill in. .env is git-ignored: never commit real values.
# scripts/push-github-settings.sh copies the GITHUB section into the repo's settings.

# ---------- App (local runs; set the same keys in Render > Environment) ----------
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=hr@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=HR Admin

# Leave empty to use the offline FakeLLM.
OPENROUTER_API_KEY=
# First is the main model, the rest are fallbacks. Check current free models on openrouter.ai.
OPENROUTER_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free

AGENTOPS_API_KEY=

DATABASE_URL=sqlite:///./data/hr.db

# ---------- GITHUB (used by the deploy workflow) ----------
# Render > your service > Settings > Deploy Hook. Saved as a GitHub *secret*.
RENDER_DEPLOY_HOOK_URL=
# Your service URL, with https:// and no trailing slash. Saved as a GitHub *variable*.
APP_URL=
